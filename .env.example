# KeyProxy Environment Variables
# Copy to .env and fill in

# Dynamic API keys (variable number: API_KEY_1, API_KEY_2, ...)
API_KEY_1=your_openrouter_key_here
# API_KEY_2=another_key
# API_KEY_3=yet_another_key

# User-based bearer auth tokens (variable number: PROXY_USER_*)
PROXY_USER_anvith=your_secret_token_here
# PROXY_USER_laptop=another_token

# Model choices (all from env; HELPER_MODEL is separate, not hardcoded)
SMART_MODEL=apodex/apodex-1.1-mini:free
WORKER_MODEL=thinkingmachines/inkling:free
HELPER_MODEL=thinkingmachines/inkling:free

# Server binding (Render uses PORT env; defaults to 4000)
HOST=0.0.0.0
PORT=4000

# Admin / OAuth settings (optional, for web dashboard)
ADMIN_EMAILS=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
